{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "VLSI: Run Functional Simulation (60k Vectors)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["simulation/run_simulation.py"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "VLSI: Run Logic Synthesis (Yosys + Sky130 HD)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["synthesis/run_synthesis.py"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "VLSI: View CSKA Waveform in GTKWave",
      "type": "shell",
      "command": "${workspaceFolder}/tools/oss-cad-suite/bin/gtkwave.exe",
      "args": ["simulation/waveforms/carry_skip_adder.vcd"],
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "never"
      },
      "problemMatcher": []
    },
    {
      "label": "VLSI: Open CSKA Layout in KLayout",
      "type": "shell",
      "command": "C:/Users/arava/AppData/Roaming/KLayout/klayout_app.exe",
      "args": [
        "physical_design/gds/cska_sky130.gds",
        "-l",
        "synthesis/sky130_pdk/sky130hd.lyp"
      ],
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "never"
      },
      "problemMatcher": []
    },
    {
      "label": "App: Start FastAPI Telemetry Backend",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["backend/app.py"],
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "App: Start Streamlit VLSI Dashboard",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/streamlit.exe",
      "args": ["run", "dashboard/app.py"],
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "App: Start CYBERCORE 3D Frontend (Vite Dev)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
