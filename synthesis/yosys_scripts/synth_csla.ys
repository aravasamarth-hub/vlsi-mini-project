# Yosys Synthesis Script for CSLA targeting SkyWater 130nm
read_verilog rtl/half_adder.v
read_verilog rtl/full_adder.v
read_verilog rtl/csla_block_4bit.v
read_verilog rtl/carry_select_adder.v
hierarchy -check -top carry_select_adder
proc
opt
flatten
opt
synth -top carry_select_adder
dfflibmap -liberty synthesis/sky130_pdk/sky130_fd_sc_hd__tt_025C_1v80.lib
abc -liberty synthesis/sky130_pdk/sky130_fd_sc_hd__tt_025C_1v80.lib
clean
write_verilog -noattr synthesis/netlists/csla_sky130_netlist.v
stat -liberty synthesis/sky130_pdk/sky130_fd_sc_hd__tt_025C_1v80.lib
