# Yosys Synthesis Script for CLA targeting SkyWater 130nm
read_verilog rtl/cla_block_4bit.v
read_verilog rtl/carry_lookahead_adder.v
hierarchy -check -top carry_lookahead_adder
proc
opt
flatten
opt
synth -top carry_lookahead_adder
dfflibmap -liberty synthesis/sky130_pdk/sky130_fd_sc_hd__tt_025C_1v80.lib
abc -liberty synthesis/sky130_pdk/sky130_fd_sc_hd__tt_025C_1v80.lib
clean
write_verilog -noattr synthesis/netlists/cla_sky130_netlist.v
stat -liberty synthesis/sky130_pdk/sky130_fd_sc_hd__tt_025C_1v80.lib
